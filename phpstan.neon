includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - config
        - database
        - routes

    level: 6

    excludePaths:
        - vendor (?)
        - node_modules (?)
        - storage (?)
        - bootstrap/cache (?)
        - tests (?)

    ignoreErrors:
        # Migration bawaan vendor (Pulse) memakai match tanpa default arm.
        -
            message: '#Match expression does not handle remaining value#'
            path: database/migrations/*create_pulse_tables.php

        # Factory generic traits pada model
        -
            message: '#uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory#'

        # Nullsafe property access
        -
            message: '#Using nullsafe property access.*is unnecessary#'

        # In-array check on empty array in Telescope
        -
            message: '#Call to function in_array\(\).*will always evaluate to false#'

        # Array values list
        -
            message: '#Parameter \#1 \$array \(list\) of array_values is already a list#'

    treatPhpDocTypesAsCertain: false

    tmpDir: storage/framework/phpstan
